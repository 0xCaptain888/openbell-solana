# Copy to .env.local and fill locally. Never commit the real key.
JUPITER_API_KEY=replace-with-your-jupiter-key

# Optional Vercel task API. The service remains visibly unconfigured until a
# remote Redis REST store, an API bearer token, and trusted policy keys exist.
OPENBELL_REDIS_REST_URL=https://replace-with-your-redis-rest-endpoint
OPENBELL_REDIS_REST_TOKEN=replace-with-your-redis-rest-token
OPENBELL_REDIS_NAMESPACE=openbell:v1
OPENBELL_API_BEARER_TOKEN=replace-with-a-long-random-token
OPENBELL_TRUSTED_POLICY_KEYS_JSON=["-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"]
OPENBELL_POLICY_MODE=strict
